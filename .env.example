# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# ─── AI provider ──────────────────────────────────────────────────────────────
# Legal Drafting prefers Groq automatically when GROQ_API_KEY is present.
# Allowed values: groq | gemini | kie
AI_PROVIDER=groq
GROQ_API_KEY=

# Optional: pin a different provider for the drafting module only.
# DRAFTING_AI_PROVIDER=groq

# Only needed when AI_PROVIDER=gemini
# GEMINI_API_KEY=

# Only needed when AI_PROVIDER=kie
# KIE_API_KEY=
# KIE_BASE_URL=https://api.kie.ai/v1
# KIE_MODEL=gpt-4o
